{
  "name": "@fitchmultz/pi-subagents",
  "version": "0.52.24",
  "description": "Pi extension for subagent orchestration and local session coordination",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./intercom-client": {
      "types": {
        "development": "./src/intercom-client.ts",
        "default": "./dist/intercom-client.d.ts"
      },
      "import": "./dist/intercom-client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-subagents.git"
  },
  "homepage": "https://github.com/fitchmultz/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-subagents/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "cli",
    "intercom",
    "coordination"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "tsconfig.build.json",
    "tsconfig.client.json",
    "tsconfig.json",
    "scripts/",
    "skills/**/*",
    "docs/reference.md",
    "docs/development.md",
    "docs/code-quality.md",
    "docs/intercom.md",
    "docs/intercom-bridge.md",
    "docs/performance.md",
    "docs/retired-history-maintenance.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:all": "node scripts/run-tests.mjs all",
    "check:compat": "node scripts/check-compat.mjs",
    "typecheck": "node scripts/typescript.mjs --noEmit",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:install": "node scripts/local-install-smoke.mjs",
    "check:size": "node scripts/measure-size.mjs",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "lint:agent": "oxlint --type-aware --deny-warnings --format=agent .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ci": "node quality/acceptance.ts",
    "smoke:real-pi": "node scripts/real-pi-smoke.mjs",
    "check:quality": "node quality/check.ts",
    "typecheck:declarations": "node quality/declarations.ts"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "24.19.2",
    "@types/sinon": "22.0.2",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "sinon": "22.1.0",
    "type-fest": "5.10.0",
    "typebox": "1.4.3",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
