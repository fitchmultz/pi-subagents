+func nativeCollectionMember(program *compiler.Program, property *ast.Symbol) bool {
+	if property == nil {
+		return false
+	}
+	for _, declaration := range property.Declarations {
+		parent := declaration.Parent
+		if parent == nil || parent.Kind != ast.KindInterfaceDeclaration ||
+			!utils.IsSourceFileDefaultLibrary(program, ast.GetSourceFileOfNode(declaration)) {
+			continue
+		}
+		switch parent.Name().Text() {
+		case "Map", "Set", "ReadonlyMap", "ReadonlySet":
+			return true
+		}
+	}
+	return false
+}
