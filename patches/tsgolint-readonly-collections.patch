+func isTypeReadonlyCollection(
+	program *compiler.Program,
+	typeChecker *checker.Checker,
+	t *checker.Type,
+	opts readonlynessOptions,
+	seenTypes map[*checker.Type]struct{},
+) readonlyness {
+	forEach := checker.Checker_getPropertyOfType(typeChecker, t, "forEach")
+	if !nativeCollectionMember(program, forEach) {
+		return readonlynessUnknown
+	}
+	// Freezing method properties does not remove collection mutation operations.
+	for _, name := range []string{"set", "add", "delete", "clear"} {
+		if nativeCollectionMember(program, checker.Checker_getPropertyOfType(typeChecker, t, name)) {
+			return readonlynessMutable
+		}
+	}
+	// The native forEach callback exposes the instantiated value and key types,
+	// including through mapped Readonly facades. Method ownership is still
+	// checked on t by the ordinary object walk, not on the callback's third
+	// collection parameter.
+	forEachType := checker.Checker_getTypeOfPropertyOfType(typeChecker, t, "forEach")
+	for _, part := range utils.UnionTypeParts(forEachType) {
+		for _, signature := range utils.GetCallSignatures(typeChecker, part) {
+			parameters := checker.Signature_parameters(signature)
+			if len(parameters) == 0 {
+				continue
+			}
+			callback := checker.Checker_getTypeOfSymbol(typeChecker, parameters[0])
+			for _, callbackSignature := range utils.GetCallSignatures(typeChecker, callback) {
+				for index, parameter := range checker.Signature_parameters(callbackSignature) {
+					if index == 2 {
+						break
+					}
+					valueType := checker.Checker_getTypeOfSymbol(typeChecker, parameter)
+					if _, seen := seenTypes[valueType]; !seen &&
+						isTypeReadonlyRecurser(program, typeChecker, valueType, opts, seenTypes) == readonlynessMutable {
+						return readonlynessMutable
+					}
+				}
+			}
+		}
+	}
+	return readonlynessUnknown
+}
