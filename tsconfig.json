{
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "noUnusedLocals": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.mjs",
    "test/**/*.cjs",
    "scripts/**/*.mjs",
    ".github/scripts/**/*.mjs"
  ]
}
