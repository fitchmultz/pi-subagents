{
	"compilerOptions": {
		"target": "ES2025",
		"lib": ["ES2025"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noUnusedLocals": true
	},
	"include": [
		"src/**/*.ts"
	]
}
