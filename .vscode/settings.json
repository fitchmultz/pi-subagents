{
  "oxc.requireConfig": true,
  "oxc.path.oxlint": "${workspaceFolder}/node_modules/.bin/oxlint",
  "oxc.path.oxfmt": "${workspaceFolder}/node_modules/.bin/oxfmt",
  "oxc.path.tsgolint": "${workspaceFolder}/node_modules/.cache/pi-quality-engine/tsgolint",
  "oxc.fixKind": "safe_fix",
  "editor.formatOnSave": true,
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][markdown][yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
